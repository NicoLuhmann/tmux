latte_base="#eff1f5"
latte_text="#4c4f69"
latte_mauve="#8839ef"
latte_surface1="#ccd0da"
latte_subtext0="#6c6f85"

set -g status-style bg=$latte_base,fg=$latte_text
set -g status-left-style bg=$latte_base,fg=$latte_mauve
set -g status-right-style bg=$latte_base,fg=$latte_text
set -g window-status-style bg=$latte_base,fg=$latte_subtext0
set -g window-status-current-style bg=$latte_mauve,fg=$latte_base
set -g pane-border-style fg=$latte_surface1
set -g pane-active-border-style fg=$latte_mauve
set -g message-style bg=$latte_mauve,fg=$latte_base
